--- /dev/null
+++ b/src/web/ConfirmationPage.tsx
@@ -0,0 +1,67 @@
+import { useQuery } from '@tanstack/react-query';
+import { cityName, formatDateWithYear, formatOtherTime, formatSpan } from '../shared/time.ts';
+import { ApiError, getBooking } from './api.ts';
+import { Avatar, Card, Progress } from './ui.tsx';
+
+export function ConfirmationPage({ id }: { id: string }) {
+  const { data, error } = useQuery({ queryKey: ['booking', id], queryFn: () => getBooking(id) });
+
+  if (!data) {
+    return (
+      <Card>
+        {!error ? (
+          <p role="status">Loading your booking…</p>
+        ) : error instanceof ApiError && error.status === 404 ? (
+          <>
+            <h1 className="text-2xl font-medium">We couldn't find that booking.</h1>
+            <a href="/" className="mt-4 inline-block font-bold underline underline-offset-4">Back to the home page</a>
+          </>
+        ) : (
+          <p role="alert" className="text-alert">We couldn't load your booking. Please refresh the page to try again.</p>
+        )}
+      </Card>
+    );
+  }
+
+  const { booking: b } = data;
+  const start = new Date(b.startsAt);
+  const end = new Date(b.endsAt);
+  const tz = b.parentTimeZone;
+
+  return (
+    <Card>
+      <Progress step={3} />
+      <h1 className="text-2xl font-medium">You're booked!</h1>
+      <p className="mt-1 text-ink-soft">{b.childName}'s free trial class</p>
+
+      <div className="mt-6 rounded-field bg-brand-50 p-4">
+        <p className="font-bold">{formatDateWithYear(start, tz)}</p>
+        <p>{formatSpan(start, end, tz)}</p>
+      </div>
+      <p className="mt-3 text-sm text-ink-soft">
+        Your mentor joins from {cityName(b.mentor.timeZone)}, where it's {formatOtherTime(start, b.mentor.timeZone, tz)}.
+      </p>
+
+      <section aria-label="Your mentor" className="mt-6 flex gap-4 rounded-field border border-line p-4">
+        <Avatar name={b.mentor.name} />
+        <div>
+          <h2 className="font-bold">{b.mentor.name}</h2>
+          <p className="text-sm text-ink-soft">{b.mentor.subjects.join(', ')}</p>
+          <p className="mt-2 text-sm">{b.mentor.bio}</p>
+        </div>
+      </section>
+
+      <a
+        href={b.classLink}
+        target="_blank"
+        rel="noreferrer"
+        className="mt-6 block w-full rounded-cta bg-brand py-4 text-center text-sm font-bold text-ink"
+      >
+        Join class
+      </a>
+      <p className="mt-2 break-all text-center text-sm text-ink-soft">{b.classLink}</p>
+
+      <p className="mt-6 text-sm text-ink-soft">We've emailed this to {b.parentEmail}.</p>
+    </Card>
+  );
+}
diff --git a/src/web/api.ts b/src/web/api.ts
new file mode 100644
index 0000000..18cbdd0
--- /dev/null
+++ b/src/web/api.ts
@@ -0,0 +1,38 @@
+import type { ApiErrorBody, BookingRequest, BookingResponse, ErrorCode, MentorsResponse, SlotsResponse } from '../shared/types.ts';
+
+export class ApiError extends Error {
+  status: number;
+  code: ErrorCode;
+  fields: Record<string, string>;
+
+  constructor(status: number, code: ErrorCode, message: string, fields: Record<string, string> = {}) {
+    super(message);
+    this.status = status;
+    this.code = code;
+    this.fields = fields;
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let res: Response;
+  try {
+    res = await fetch(path, init);
+  } catch {
+    // offline or the server is down: a 5xx so queries retry it
+    throw new ApiError(503, 'INTERNAL', "We can't reach the server. Check your connection and try again.");
+  }
+  const body: unknown = await res.json().catch(() => null);
+  if (res.ok) return body as T;
+  const error = (body as ApiErrorBody | null)?.error;
+  throw new ApiError(res.status, error?.code ?? 'INTERNAL', error?.message ?? 'Something went wrong. Please try again.', error?.fields);
+}
+
+export const getSlots = () => request<SlotsResponse>('/api/slots');
+export const getMentors = () => request<MentorsResponse>('/api/mentors');
+export const getBooking = (id: string) => request<BookingResponse>('/api/bookings/' + encodeURIComponent(id));
+export const createBooking = (body: BookingRequest) =>
+  request<BookingResponse>('/api/bookings', {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(body),
+  });
diff --git a/src/web/hooks.ts b/src/web/hooks.ts
new file mode 100644
index 0000000..db49032
--- /dev/null
+++ b/src/web/hooks.ts
@@ -0,0 +1,44 @@
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useState } from 'react';
+import { ApiError, createBooking, getSlots } from './api.ts';
+import { initialTimeZone } from './booking.ts';
+
+function readSavedZone(): string | null {
+  try {
+    return localStorage.getItem('tz');
+  } catch {
+    return null; // storage blocked: fall back to the device zone
+  }
+}
+
+export function useTimeZone() {
+  const deviceTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
+  const [timeZone, setZone] = useState(() => initialTimeZone(readSavedZone(), deviceTimeZone));
+  const setTimeZone = (tz: string) => {
+    setZone(tz);
+    try {
+      localStorage.setItem('tz', tz);
+    } catch {
+      // storage blocked: the choice still holds for this visit
+    }
+  };
+  return { timeZone, setTimeZone, deviceTimeZone };
+}
+
+export function useSlots() {
+  return useQuery({ queryKey: ['slots'], queryFn: getSlots, refetchInterval: 60_000 });
+}
+
+export function useBookSlot(onUnavailable: (startsAt: string) => void) {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: createBooking,
+    onSuccess: ({ booking }) => location.assign('/bookings/' + booking.id),
+    onError: (error, variables) => {
+      if (error instanceof ApiError && error.status === 409) {
+        void queryClient.invalidateQueries({ queryKey: ['slots'] });
+        onUnavailable(variables.startsAt);
+      }
+    },
+  });
+}
