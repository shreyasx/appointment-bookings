+++ b/src/server/seed.ts
@@ -0,0 +1,111 @@
+import type pg from 'pg';
+import { bookSlot, loadActiveBookings, loadMentors } from './bookings.ts';
+import { buildSlots, type WorkingHours } from './slots.ts';
+
+type Shift = 'uk' | 'us';
+export type SeedMentor = { name: string; email: string; subjects: string[]; bio: string; shift: Shift; hours: WorkingHours[] };
+
+const MENTOR_TIME_ZONE = 'Asia/Kolkata';
+const HOUR_MS = 3_600_000;
+const DAY_MS = 24 * HOUR_MS;
+
+// Working hours are in the mentor's own time zone. The "uk" shift teaches the UK evening and weekend, the "us" shift the US evening.
+function hoursFor(shift: Shift, offWeekday?: number): WorkingHours[] {
+  const hours =
+    shift === 'uk'
+      ? [...[1, 2, 3, 4, 5].map((weekday) => ({ weekday, start: '20:30', end: '23:30' })), ...[0, 6].map((weekday) => ({ weekday, start: '14:30', end: '18:30' }))]
+      : [0, 2, 3, 4, 5, 6].map((weekday) => ({ weekday, start: '02:30', end: '07:30' }));
+  return hours.filter((h) => h.weekday !== offWeekday);
+}
+
+const mentor = (name: string, subjects: string[], bio: string, shift: Shift, offWeekday?: number): SeedMentor => ({
+  name,
+  email: `${name.toLowerCase().replace(' ', '.')}@mentors.example`,
+  subjects,
+  bio,
+  shift,
+  hours: hoursFor(shift, offWeekday),
+});
+
+export const SEED_MENTORS: SeedMentor[] = [
+  mentor('Priya Sharma', ['Coding', 'Math'], 'Turns first lines of code and tricky fractions into small wins that make a child want to try the next one.', 'uk'),
+  mentor('Arjun Mehta', ['Coding'], 'Teaches coding through games and animations, so every lesson ends with something a child can show off.', 'uk'),
+  mentor('Ananya Iyer', ['Math', 'Science'], 'Explains math and science with kitchen-table experiments and plenty of worked examples.', 'uk'),
+  mentor('Kavya Nair', ['English'], 'Builds confident readers and writers through storytelling, vocabulary games and gentle feedback.', 'uk'),
+  mentor('Vikram Rao', ['Coding', 'Science'], 'Mixes hands-on science demos with beginner-friendly coding projects.', 'uk', 5), // no Friday
+  mentor('Sneha Kulkarni', ['Math'], 'Makes math patient and visual, with number puzzles that turn mistakes into the interesting part.', 'us'),
+  mentor('Aditya Joshi', ['Coding'], 'Guides young beginners from block-based coding to a first real Python program.', 'us'),
+  mentor('Meera Pillai', ['Science'], 'Runs curious, question-driven science lessons built around experiments that can be done at home.', 'us'),
+  mentor('Karan Malhotra', ['Coding', 'Math'], 'Pairs logic puzzles with coding and math practice, always at the pace of the child.', 'us'),
+  mentor('Divya Reddy', ['English', 'Math'], 'Helps children find a voice in English and steady footing in math, one friendly session at a time.', 'us', 2), // no Tuesday
+];
+
+// Made-up families, cycled through by the pre-booked classes.
+const PARENTS = [
+  { name: 'Emma Clarke', childName: 'Noah', parentTimeZone: 'Europe/London' },
+  { name: 'Jacob Miller', childName: 'Ava', parentTimeZone: 'America/New_York' },
+  { name: 'Olivia Brooks', childName: 'Leo', parentTimeZone: 'America/Chicago' },
+  { name: 'Liam Carter', childName: 'Mia', parentTimeZone: 'America/Los_Angeles' },
+];
+
+async function upsertMentors(pool: pg.Pool): Promise<void> {
+  const client = await pool.connect();
+  try {
+    await client.query('begin');
+    for (const m of SEED_MENTORS) {
+      const { rows } = await client.query(
+        `insert into mentors (name, email, time_zone, bio, subjects) values ($1, $2, $3, $4, $5)
+         on conflict (email) do update set name = excluded.name, time_zone = excluded.time_zone, bio = excluded.bio, subjects = excluded.subjects
+         returning id`,
+        [m.name, m.email, MENTOR_TIME_ZONE, m.bio, m.subjects],
+      );
+      await client.query('delete from mentor_hours where mentor_id = $1', [rows[0].id]);
+      for (const h of m.hours) {
+        await client.query('insert into mentor_hours (mentor_id, weekday, start_time, end_time) values ($1, $2, $3, $4)', [rows[0].id, h.weekday, h.start, h.end]);
+      }
+    }
+    await client.query('commit');
+  } catch (err) {
+    await client.query('rollback').catch(() => {}); // keep the first error
+    throw err;
+  } finally {
+    client.release();
+  }
+}
+
+/** A fully booked stretch two days out and one full hour later on, so a demo always has both. Only on an empty bookings table. */
+async function preBook(pool: pg.Pool, now: Date): Promise<number> {
+  if ((await pool.query('select count(*)::int as n from bookings')).rows[0].n > 0) return 0;
+
+  // the same margins the slots endpoint uses
+  const openSlots = async () =>
+    buildSlots(await loadMentors(pool), await loadActiveBookings(pool, new Date(now.getTime() - 2 * DAY_MS), new Date(now.getTime() + 16 * DAY_MS)), now).filter((s) => s.available);
+
+  let booked = 0;
+  const bookUntilFull = async (startsAt: Date): Promise<void> => {
+    for (;;) {
+      const parent = PARENTS[booked % PARENTS.length]!;
+      const result = await bookSlot(pool, { startsAt, parentName: parent.name, parentEmail: `parent${(booked % PARENTS.length) + 1}@example.com`, childName: parent.childName, parentTimeZone: parent.parentTimeZone }, now);
+      if (!result.ok) return;
+      booked++;
+    }
+  };
+
+  // Any 50-hour block holds a whole local day in every zone, so London, New York and Los Angeles all see a day marked full.
+  const blockStart = now.getTime() + 2 * DAY_MS;
+  const blockEnd = blockStart + 50 * HOUR_MS;
+  for (const slot of await openSlots()) {
+    if (slot.startsAt.getTime() >= blockStart && slot.startsAt.getTime() < blockEnd) await bookUntilFull(slot.startsAt);
+  }
+
+  // 16:00 UTC is a UK-shift hour on weekdays, so it fills while the other hours that day stay open.
+  const popular = (await openSlots()).find((s) => s.startsAt.getTime() >= now.getTime() + 5 * DAY_MS && s.startsAt.getUTCHours() === 16);
+  if (popular) await bookUntilFull(popular.startsAt);
+  return booked;
+}
+
+/** Safe to repeat: mentors and their hours are rewritten each run, classes are pre-booked only once. */
+export async function seed(pool: pg.Pool, now: Date): Promise<{ mentors: number; preBooked: number }> {
+  await upsertMentors(pool);
+  return { mentors: SEED_MENTORS.length, preBooked: await preBook(pool, now) };
+}
diff --git a/src/server/slots.test.ts b/src/server/slots.test.ts
new file mode 100644
index 0000000..595ad3a
--- /dev/null
+++ b/src/server/slots.test.ts
@@ -0,0 +1,82 @@
+import { expect, test } from 'vitest';
+import { localDate } from '../shared/time.ts';
+import { buildSlots, classStarts, isBookableTime, worksAt, type ActiveBooking, type Mentor, type Slot, type WorkingHours } from './slots.ts';
+
+const NOW = new Date('2026-10-20T12:00:00Z');
+const hours = (weekdays: number[], start: string, end: string): WorkingHours[] => weekdays.map((weekday) => ({ weekday, start, end }));
+const mentor = (id: number, timeZone: string, h: WorkingHours[]): Mentor =>
+  ({ id, name: `M${id}`, email: `m${id}@mentors.example`, bio: '', subjects: [], timeZone, hours: h });
+const ukEvening = (id: number) => mentor(id, 'Asia/Kolkata', hours([1, 2, 3, 4, 5], '20:30', '23:30'));
+const isoList = (dates: Date[]) => dates.map((d) => d.toISOString());
+const slotAt = (slots: Slot[], iso: string) => slots.find((s) => s.startsAt.toISOString() === iso);
+const booking = (mentorId: number, iso: string, day: string): ActiveBooking => ({ mentorId, startsAt: new Date(iso), mentorLocalDate: day });
+
+test('weekly hours become class starts on the UTC hour', () => {
+  expect(isoList(classStarts(ukEvening(1), new Date('2026-10-27T00:00:00Z'), new Date('2026-10-28T00:00:00Z'))))
+    .toEqual(['2026-10-27T15:00:00.000Z', '2026-10-27T16:00:00.000Z', '2026-10-27T17:00:00.000Z']);
+});
+
+test('the window runs from 2 hours to 14 days ahead, both inclusive', () => {
+  const slots = buildSlots([mentor(1, 'UTC', hours([0, 1, 2, 3, 4, 5, 6], '00:00', '23:59'))], [], NOW);
+  expect(slots[0]!.startsAt.toISOString()).toBe('2026-10-20T14:00:00.000Z');
+  expect(slots.at(-1)!.startsAt.toISOString()).toBe('2026-11-03T12:00:00.000Z');
+  expect(isBookableTime(new Date('2026-10-20T14:00:00Z'), NOW)).toBe(true);
+  expect(isBookableTime(new Date('2026-10-20T13:00:00Z'), NOW)).toBe(false); // too soon
+  expect(isBookableTime(new Date('2026-10-20T14:30:00Z'), NOW)).toBe(false); // not on the hour
+  expect(isBookableTime(new Date('2026-11-03T13:00:00Z'), NOW)).toBe(false); // beyond 14 days
+});
+
+test('an hour is full only when every mentor working it is taken', () => {
+  const two = [ukEvening(1), ukEvening(2)];
+  const at16 = (b: ActiveBooking[]) => slotAt(buildSlots(two, b, NOW), '2026-10-27T16:00:00.000Z')?.available;
+  expect(at16([booking(1, '2026-10-27T16:00:00Z', '2026-10-27')])).toBe(true);
+  expect(at16([booking(1, '2026-10-27T16:00:00Z', '2026-10-27'), booking(2, '2026-10-27T16:00:00Z', '2026-10-27')])).toBe(false);
+});
+
+test("the cap closes only the rest of the mentor's own day", () => {
+  const slots = buildSlots([ukEvening(1)], [booking(1, '2026-10-27T15:00:00Z', '2026-10-27'), booking(1, '2026-10-27T16:00:00Z', '2026-10-27')], NOW);
+  expect(slotAt(slots, '2026-10-27T17:00:00.000Z')?.available).toBe(false);
+  expect(slotAt(slots, '2026-10-28T15:00:00.000Z')?.available).toBe(true);
+});
+
+test("a Los Angeles parent's Monday evening counts toward the mentor's Tuesday", () => {
+  const laMonday = '2026-10-27T01:00:00Z'; // Mon 26 Oct, 6:00 PM PDT = Tue 27 Oct, 6:30 AM in Kolkata
+  expect(localDate(new Date(laMonday), 'America/Los_Angeles')).toBe('2026-10-26');
+  const m = mentor(1, 'Asia/Kolkata', [...hours([2], '06:30', '07:30'), ...hours([1, 2], '20:30', '22:30')]);
+  const slots = buildSlots([m], [booking(1, laMonday, '2026-10-27'), booking(1, '2026-10-27T15:00:00Z', '2026-10-27')], NOW);
+  expect(slotAt(slots, '2026-10-27T16:00:00.000Z')?.available).toBe(false); // Tuesday is at the cap
+  expect(slotAt(slots, '2026-10-26T15:00:00.000Z')?.available).toBe(true);  // Monday is untouched
+});
+
+test("the cap uses the mentor's own day, not the UTC day", () => {
+  // Tue 02:30-07:30 in Kolkata runs from Mon 26 Oct 21:00Z to Tue 27 Oct 02:00Z
+  const m = mentor(1, 'Asia/Kolkata', hours([2], '02:30', '07:30'));
+  const slots = buildSlots([m], [booking(1, '2026-10-26T21:00:00Z', '2026-10-27'), booking(1, '2026-10-26T22:00:00Z', '2026-10-27')], NOW);
+  for (const iso of ['2026-10-26T23:00:00.000Z', '2026-10-27T00:00:00.000Z', '2026-10-27T01:00:00.000Z'])
+    expect(slotAt(slots, iso)?.available).toBe(false); // the mentor's Tuesday is full on either UTC date
+  expect(slotAt(slots, '2026-11-02T21:00:00.000Z')?.available).toBe(true); // next Tuesday is open
+});
+
+test('a mentor in New York on the spring-forward day', () => {
+  const ny = (start: string, end: string) => mentor(1, 'America/New_York', hours([0], start, end));
+  const day = [new Date('2026-03-08T00:00:00Z'), new Date('2026-03-09T00:00:00Z')] as const;
+  expect(isoList(classStarts(ny('02:00', '05:00'), ...day))).toEqual(['2026-03-08T07:00:00.000Z', '2026-03-08T08:00:00.000Z']);
+  expect(isoList(classStarts(ny('02:30', '05:30'), ...day))).toEqual(['2026-03-08T08:00:00.000Z']); // window starts 3:30 EDT; first class 4:00 EDT
+});
+
+test('a mentor in New York on the fall-back day', () => {
+  const m = mentor(1, 'America/New_York', hours([0], '01:00', '03:00'));
+  expect(isoList(classStarts(m, new Date('2026-11-01T00:00:00Z'), new Date('2026-11-02T00:00:00Z'))))
+    .toEqual(['2026-11-01T05:00:00.000Z', '2026-11-01T06:00:00.000Z', '2026-11-01T07:00:00.000Z']);
+});
+
+test("US-evening hours put both of London's 1:00 AM slots on 25 Oct", () => {
+  const starts = buildSlots([mentor(6, 'Asia/Kolkata', hours([0, 2, 3, 4, 5, 6], '02:30', '07:30'))], [], NOW).map((s) => s.startsAt.toISOString());
+  expect(starts).toEqual(expect.arrayContaining(['2026-10-25T00:00:00.000Z', '2026-10-25T01:00:00.000Z']));
+});
+
+test("worksAt fits the whole class inside the mentor's hours", () => {
+  expect(worksAt(ukEvening(1), new Date('2026-10-27T17:00:00Z'))).toBe(true);  // 10:30-11:30 PM in Kolkata
+  expect(worksAt(ukEvening(1), new Date('2026-10-27T18:00:00Z'))).toBe(false); // would end after 11:30 PM
+  expect(worksAt(ukEvening(1), new Date('2026-10-25T15:00:00Z'))).toBe(false); // Sunday
+});
diff --git a/src/server/slots.ts b/src/server/slots.ts
new file mode 100644
index 0000000..e6ead8f
--- /dev/null
+++ b/src/server/slots.ts
@@ -0,0 +1,69 @@
+import { addDays, localDate, weekdayOf, zonedTimeToInstant } from '../shared/time.ts';
+
+export const CLASS_MINUTES = 60, LEAD_MINUTES = 120, HORIZON_DAYS = 14, DAILY_CAP = 2;
+
+const MINUTE_MS = 60_000;
+const HOUR_MS = 60 * MINUTE_MS;
+const CLASS_MS = CLASS_MINUTES * MINUTE_MS;
+
+export type WorkingHours = { weekday: number; start: string; end: string }; // 'HH:MM', in the mentor's own time zone
+export type Mentor = { id: number; name: string; email: string; bio: string; subjects: string[]; timeZone: string; hours: WorkingHours[] };
+export type ActiveBooking = { mentorId: number; startsAt: Date; mentorLocalDate: string };
+export type Slot = { startsAt: Date; available: boolean };
+
+/** On the UTC hour, and inside [now + 120 minutes, now + 14 days], both ends inclusive. */
+export function isBookableTime(startsAt: Date, now: Date): boolean {
+  const t = startsAt.getTime();
+  return t % HOUR_MS === 0 && t >= now.getTime() + LEAD_MINUTES * MINUTE_MS && t <= now.getTime() + HORIZON_DAYS * 24 * HOUR_MS;
+}
+
+/** The mentor's working windows on one of their own calendar days, as [open, close] in epoch ms. */
+function windows(mentor: Mentor, date: string): [number, number][] {
+  const weekday = weekdayOf(date);
+  return mentor.hours
+    .filter((h) => h.weekday === weekday)
+    .map((h) => [zonedTimeToInstant(date, h.start, mentor.timeZone).getTime(), zonedTimeToInstant(date, h.end, mentor.timeZone).getTime()]);
+}
+
+/** True when the whole class fits one working-hours window on the mentor's own day. */
+export function worksAt(mentor: Mentor, startsAt: Date): boolean {
+  const t = startsAt.getTime();
+  return windows(mentor, localDate(startsAt, mentor.timeZone)).some(([open, close]) => t >= open && t + CLASS_MS <= close);
+}
+
+/** Class starts on the UTC hour inside [from, to], sorted and unique. */
+export function classStarts(mentor: Mentor, from: Date, to: Date): Date[] {
+  const starts = new Set<number>();
+  // a day either side is purely defensive; walking the mentor's own local dates already covers a UTC-date straddle
+  const last = addDays(localDate(to, mentor.timeZone), 1);
+  for (let date = addDays(localDate(from, mentor.timeZone), -1); date <= last; date = addDays(date, 1)) {
+    for (const [open, close] of windows(mentor, date)) {
+      for (let t = Math.ceil(open / HOUR_MS) * HOUR_MS; t + CLASS_MS <= close; t += HOUR_MS) {
+        if (t >= from.getTime() && t <= to.getTime()) starts.add(t);
+      }
+    }
+  }
+  return [...starts].sort((a, b) => a - b).map((t) => new Date(t));
+}
+
+/** Every bookable hour, open or full, sorted by start. An hour is open when any mentor working it is free and under the daily cap. */
+export function buildSlots(mentors: Mentor[], bookings: ActiveBooking[], now: Date): Slot[] {
+  const taken = new Set(bookings.map((b) => `${b.mentorId}|${b.startsAt.getTime()}`));
+  const perDay = new Map<string, number>();
+  for (const b of bookings) {
+    const key = `${b.mentorId}|${b.mentorLocalDate}`;
+    perDay.set(key, (perDay.get(key) ?? 0) + 1);
+  }
+
+  const from = new Date(now.getTime() + LEAD_MINUTES * MINUTE_MS);
+  const to = new Date(now.getTime() + HORIZON_DAYS * 24 * HOUR_MS);
+  const open = new Map<number, boolean>();
+  for (const mentor of mentors) {
+    for (const start of classStarts(mentor, from, to)) {
+      const t = start.getTime();
+      const free = !taken.has(`${mentor.id}|${t}`) && (perDay.get(`${mentor.id}|${localDate(start, mentor.timeZone)}`) ?? 0) < DAILY_CAP;
+      open.set(t, (open.get(t) ?? false) || free);
+    }
+  }
+  return [...open].sort((a, b) => a[0] - b[0]).map(([t, available]) => ({ startsAt: new Date(t), available }));
+}
