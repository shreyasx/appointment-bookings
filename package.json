{
  "name": "appointment-bookings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "dev:server": "node --watch src/server/main.ts",
